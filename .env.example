# Postgres database
POSTGRES_PORT=5432
POSTGRES_DB=work_from_home
POSTGRES_USER=work_from_home
POSTGRES_PASSWORD=work_from_home_password

# Work from home app
DATABASE_URL=postgres://work_from_home:work_from_home_password@postgres:5432/work_from_home
SESSION_SECRET=change-me-with-a-long-random-secret
SESSION_COOKIE_SECURE=true

# Oracle (TIMERTASK_ES) - read-only access for absences/vacations
# Use a read-only Oracle user. Oracle 11g needs thick mode + Instant Client.
ORACLE_USER=your_readonly_user
ORACLE_PASSWORD=your_readonly_password
ORACLE_CONNECT_STRING=host:1521/SERVICE_NAME
# Path to the Oracle Instant Client (required for thick mode). Leave empty to use system PATH.
ORACLE_CLIENT_LIB_DIR=
# Schema that owns the TIMERTASK tables (allows reuse for other countries).
ORACLE_TIMERTASK_SCHEMA=TIMERTASK_ES
# Comma-separated TLINEAS.linea_id whose active employees are shown/counted in
# the app. Leave empty to use the defaults (INT=100, VIN_MAN=1600,
# Global DDCs=1606, Data Accuracy=1611).
ORACLE_STAFF_LINE_IDS=100,1600,1606,1611
